# SILLDA - .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Environnements virtuels
venv/
env/
ENV/
env.bak/
venv.bak/
.venv

# Conda
.conda/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# Modèles et données (gros fichiers)
models/pretrained/*.ckpt
models/pretrained/*.h5
models/pretrained/*.pb
models/trained/*
!models/trained/.gitkeep

data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Logs
*.log
logs/
experiments/logs/*
!experiments/logs/.gitkeep
realtimesst.log

# Résultats d'expériences
experiments/results/*
!experiments/results/.gitkeep

# Fichiers temporaires
*.tmp
*.temp
*.cache

# OS
Thumbs.db
.DS_Store

# Fichiers de configuration locaux
config/local_*.yaml
*.local.yaml

# Fichiers audio/vidéo (optionnel - décommenter si nécessaire)
# *.mp4
# *.avi
# *.mov
# *.wav
# *.mp3

# Fichiers dlib (gros fichiers)
data/raw/lip_reading_dlib/shape_predictor_68_face_landmarks.dat

# Fichiers de checkpoint TensorFlow
*.ckpt*
checkpoint
checkpoint.*

# Fichiers de sauvegarde
*.bak
*.backup
